# Server
PORT=3000

# PostgreSQL / Supabase (PostGIS)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nextbus
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Redis (Upstash in production / local OrbStack Redis in development)
REDIS_URL=redis://localhost:6379

# Google Connected Apps Domain Verification
GOOGLE_VERIFICATION_TOKEN=replace-with-google-connected-apps-token
